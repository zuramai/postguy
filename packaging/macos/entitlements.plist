<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Postguy. Deliberately minimal: the app is pure Rust, loads no
     unsigned code, needs no JIT (the script engine is an interpreter) and is not sandboxed (it opens
     workspace files by path). The only entry is outgoing network access, for the requests the user
     sends. Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
